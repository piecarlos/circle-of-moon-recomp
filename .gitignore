# Never commit the game or anything derived from it
*.gba
*.GBA
*.sav
*.bak
rom/
build/
build-*/
out/
.DS_Store
.vscode/
.idea/

# Disassembler / analysis output derived from the ROM
generated/
generated/**/*.s
generated/**/*.asm
*.bin
*.lz

# Screenshots
*.png
*.jpg
*.jpeg
Screenshot*
# Original CircleMoon artwork (logo, icon mark) is committed
!assets/**/*.png

# Milestone screenshots (may show ROM-derived art)
screenshots/
!assets/screenshots/
!assets/screenshots/*.png

# FetchContent downloads (CI and local builds)
.deps/

# Android build & IDE artifacts (never commit APKs or bundled ROMs)
*.apk
*.aab
android/.gradle/
android/app/.cxx/
android/app/build/
android/app/src/main/assets/
android/build/
android/local.properties
push-github.ps1
push-github.bat
